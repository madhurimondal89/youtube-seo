# =================================================================
# TubePilot AI — Complete Configuration File
# Optimized for Local Development & Production (Hostinger VPS / Coolify)
# =================================================================

# Server & Security
APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-secret-key-in-production-random-hex-string

# Server Bindings (FastAPI Backend)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Persistent Storage (SQLite default / PostgreSQL compatible)
DATABASE_URL=sqlite:///./backend/data/youtube_seo.db

# -----------------------------------------------------------------
# AI Layer Configuration (Optional — Deterministic fallback if disabled)
# -----------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=ollama
# Supported providers: ollama, lmstudio, localai, groq, deepseek, openrouter, gemini, openai, custom

# 1. Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60

# 2. Local LM Studio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# 3. LocalAI (Self-hosted)
LOCALAI_BASE_URL=http://localhost:8080/v1
LOCALAI_MODEL=gpt-4

# 4. Groq Fast Inference (Cloud)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 5. DeepSeek AI (Cloud)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 6. OpenRouter (Multi-model Cloud Gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 7. Google Gemini (Native Cloud)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 8. OpenAI (Cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 9. Custom OpenAI-Compatible Endpoint (vLLM, Ollama v1, Text-Gen WebUI, etc.)
CUSTOM_AI_BASE_URL=http://localhost:1234/v1
CUSTOM_AI_MODEL=custom-model
CUSTOM_AI_API_KEY=

# -----------------------------------------------------------------
# YouTube Data Providers (Default is Public, API Key is 100% Optional)
# -----------------------------------------------------------------
YOUTUBE_PROVIDER=public
# Providers: "public" (suggest/oembed/watch meta/RSS), "api" (Google Data API v3), "mock"
YOUTUBE_API_KEY=
MAX_SEARCH_RESULTS=25
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_PER_MINUTE=60

# Cache & Performance (In-Memory Stateless Cache)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
MAX_CONCURRENT_JOBS=3
