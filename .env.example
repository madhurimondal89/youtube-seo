# =================================================================
# TubePilot AI — Configuration File
# =================================================================

APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-secret-key-in-production-random-hex-string

# Server Bindings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# AI Configuration (Optional Layer)
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60

# Cloud AI (Optional - only if user desires)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# YouTube Data Providers
YOUTUBE_PROVIDER=public
YOUTUBE_API_KEY=
MAX_SEARCH_RESULTS=25
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_PER_MINUTE=60

# Cache & Performance (In-Memory Stateless Cache)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
MAX_CONCURRENT_JOBS=3
